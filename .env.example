# Copy to `.env` (gitignored) and fill in. Loaded automatically by
# server/env.py for `uvicorn server.app:app` and `python -m scripts.*`, and by
# Docker Compose for ${VAR} interpolation. Real environment variables always
# win over this file.

# Google Books API key. WITHOUT ONE, GOOGLE BOOKS RETURNS 429 ON EVERY REQUEST
# — keyless calls share one global anonymous quota pool that is routinely
# already exhausted — and the app silently falls back to Open Library alone.
# That makes local search results and every local measurement systematically
# thinner than production's. `python -m scripts.explain_similar` prints a
# banner when this has happened.
#
# Get one: Google Cloud Console -> APIs & Services -> enable "Books API" ->
# Credentials -> Create credentials -> API key. The free tier is 1000
# requests/day. The production key is IP-restricted to the Lightsail host, so
# it will 403 from a laptop — local dev needs its own, either unrestricted or
# restricted to your current IP.
GOOGLE_BOOKS_API_KEY=

# Where the SQLite database lives. Defaults to data/library.db.
#BOOKREC_DB_PATH=data/library.db

# Set true when serving over HTTPS so the session cookie is HTTPS-only.
#BOOKREC_SECURE_COOKIES=true

# Requests slower than this (ms) log at WARNING. Default 2000.
#BOOKREC_SLOW_REQUEST_MS=2000

# Opt-in tracemalloc leak finder — adds per-allocation overhead, so turn it on
# only when /admin/stats says memory is climbing.
#BOOKREC_TRACEMALLOC=false
#BOOKREC_TRACEMALLOC_EVERY=500
